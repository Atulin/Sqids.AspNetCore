<?xml version="1.0" encoding="utf-8"?>
<!--
  Code coverage settings for this test suite.

  Every hand-written line of Sqids.AspNetCore is exercised by these tests, but referencing
  Microsoft.AspNetCore.OpenApi compiles about 760 lines of source-generated support code (XML
  comment transformers) into the library. It carries [GeneratedCode] and can never run from here,
  so it is excluded instead of dragging the reported number down from about 100% to about 64%.

  To collect coverage, pass the "coverage", "coverage-output-format" and "coverage-settings"
  options to the test executable (each prefixed by two hyphens), using this file as the settings
  path. See README.md for the exact command.
-->
<Configuration>
  <CodeCoverage>
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Runtime\.CompilerServices\.CompilerGeneratedAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.DebuggerNonUserCodeAttribute$</Attribute>
      </Exclude>
    </Attributes>
    <Sources>
      <Exclude>
        <Source>.*[\\/]obj[\\/].*</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
