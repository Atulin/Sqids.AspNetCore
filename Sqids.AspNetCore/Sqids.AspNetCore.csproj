<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Sqids.AspNetCore</RootNamespace>
      
    <PackageId>Sqids.AspNetCore</PackageId>
      <PackageVersion>1.0.0</PackageVersion>
      <Title>Sqids.AspNetCore</Title>
      <Description>SQID implementation made specifically for ASP.NET Core usage</Description>
      <Authors>Atulin</Authors>
      <PackageTags>squd;asp;asp-core;asp.net</PackageTags>

      <PackageProjectUrl>https://github.com/Atulin/Sqids.AspNetCore</PackageProjectUrl>
      <RepositoryUrl>https://github.com/Atulin/Sqids.AspNetCore</RepositoryUrl>
      <PublishRepositoryUrl>true</PublishRepositoryUrl>
      <RepositoryType>git</RepositoryType>

      <PackageReadmeFile>README.md</PackageReadmeFile>
      <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
  </ItemGroup>

</Project>
